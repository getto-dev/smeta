{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/getto-dev/smeta/main/data/schema/config.schema.json",
  "title": "SmetaPro profile config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "name",
    "locale",
    "currency"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "features": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
