{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/getto-dev/smeta/main/data/schema/synonyms.schema.json",
  "title": "SmetaPro search synonyms",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "groups"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
